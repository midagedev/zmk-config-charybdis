#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

// "Timeless" home-row mods (per official ZMK docs):
// hold only resolves when an opposite-hand key is involved, and is
// suppressed entirely while typing at speed, so timing matters much less.
/ {
    macros {
        // Layer-hold sentinels for the host-side overlay app: while the layer
        // key is held, the firmware also holds F13/F14 (no default action on
        // macOS) so charybdis-overlay can show the active layer in real time.
        l1_signal: l1_signal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo 1 &kp F13>
                , <&macro_pause_for_release>
                , <&macro_release &mo 1 &kp F13>
                ;
        };
        l2_signal: l2_signal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo 2 &kp F14>
                , <&macro_pause_for_release>
                , <&macro_release &mo 2 &kp F14>
                ;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
            // right-hand positions (incl. right thumb cluster)
            hold-trigger-key-positions =
                <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 50 51 52 55>;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
            // left-hand positions (incl. left thumb cluster)
            hold-trigger-key-positions =
                <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 53 54>;
        };

        // Layer keys with the same feel as &lt, but the hold action also
        // emits the F13/F14 sentinel (see macros above). #binding-cells is
        // fixed at 2 by the hold-tap binding; the first param is a dummy
        // consumed by the parameterless signal macro, the second is the
        // tap keycode (e.g. &l1lt 0 SPACE).
        l1lt: l1lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&l1_signal>, <&kp>;
        };
        l2lt: l2lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&l2_signal>, <&kp>;
        };
    };
};

&trackball_listener {
    scroller {
        layers = <1 2>;
        input-processors = <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        escc {
            bindings = <&kp ESC>;
            key-positions = <17 18>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp ESC       &kp N1  &kp N2  &kp N3       &kp N4            &kp N5          &kp N6     &kp N7     &kp N8     &kp N9   &kp N0     &kp BSPC
&kp TAB       &kp Q   &kp W   &kp E        &kp R             &kp T           &kp Y      &kp U      &kp I      &kp O    &kp P      &kp BACKSLASH
&kp CAPSLOCK  &hml LALT A   &hml LCTRL S   &hml LSHIFT D   &hml LGUI F       &kp G           &kp H      &hmr RGUI J      &hmr RSHIFT K     &hmr RCTRL L    &hmr RALT SEMI  &kp APOS
&kp LSHIFT    &kp Z   &kp X   &kp C        &kp V             &kp B           &kp N      &kp M      &kp COMMA  &kp DOT  &kp SLASH  &kp EQUAL
                              &l1lt 0 SPACE  &l2lt 0 SPACE   &kp LCTRL       &kp MINUS  &l2lt 0 ENTER
                                           &kp LEFT_COMMAND  &kp LEFT_ALT    &mkp MB1
            >;
        };

        layer_1 {
            display-name = "Sym/Fn";
            bindings = <
&kp GRAVE       &kp F1     &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7           &kp F8            &kp F9            &kp F10            &kp F11
&trans          &bt BT_CLR &trans  &trans  &trans  &trans    &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE   &kp F12
&trans          &trans     &trans  &trans  &trans  &trans    &trans  &trans            &trans             &trans            &trans             &trans
&trans          &trans            &trans  &trans  &trans  &trans    &trans  &trans          &trans          &trans            &trans             &trans
                                                &trans  &trans  &trans    &trans  &trans
                                                        &trans  &trans    &trans
            >;
        };

        layer_2 {
            display-name = "Nav/Mouse";
            bindings = <
&trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans      &trans    &trans    &trans    &trans
&kp LC(UP_ARROW)  &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(DOWN_ARROW)  &trans    &trans    &trans  &kp DEL     &kp HOME  &kp PG_UP  &kp PG_DN  &kp END
&trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans    &trans    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans    &trans    &trans    &trans    &trans    &trans  &trans      &trans    &trans    &trans    &trans
                                                &trans  &trans  &trans    &trans  &trans
                                                        &trans  &trans    &trans
            >;
        };

        extra_layer_3 {
            status = "reserved";
        };
    };
};
